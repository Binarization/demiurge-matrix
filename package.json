{
    "name": "demiurge-matrix",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:host": "vite --host",
        "build": "vite build && node scripts/check-pages-assets.mjs",
        "test": "bun test",
        "preview": "vite preview",
        "format": "prettier --write \"src/**/*.{js,ts,vue,css,scss,json}\" \"*.{js,ts,json,md}\"",
        "voice:prepare": "node scripts/prepare-voice.mjs",
        "voice:build": "wasm-pack build voice-frontend --target web --out-dir ../src/lib/voice/wasm --release && node scripts/sync-voice-runtime.mjs",
        "voice:check": "node scripts/check-voice-frontend.mjs",
        "voice:test-browser": "node scripts/check-voice-browser.mjs",
        "predev": "node scripts/check-voice-build.mjs",
        "prebuild": "node scripts/check-voice-build.mjs",
        "voice:test-streaming": "node scripts/check-streaming-browser.mjs",
        "test:ui": "node scripts/check-companion-ui.mjs",
        "test:speech-input": "node scripts/check-speech-input-browser.mjs"
    },
    "dependencies": {
        "@iconify-json/mdi": "^1.2.3",
        "@openrouter/sdk": "^0.1.8",
        "@pixiv/three-vrm": "^3.4.4",
        "@pixiv/three-vrm-animation": "^3.4.4",
        "@tailwindcss/vite": "^4.1.17",
        "flexsearch": "^0.8.212",
        "onnxruntime-web": "1.24.3",
        "tailwindcss": "^4.1.17",
        "three": "^0.181.1",
        "unplugin-icons": "^22.5.0",
        "vite-plugin-wasm": "^3.5.0",
        "vue": "^3.5.24"
    },
    "devDependencies": {
        "@types/flexsearch": "^0.7.6",
        "@types/node": "^24.10.0",
        "@types/three": "^0.181.0",
        "@vitejs/plugin-vue": "^6.0.1",
        "@vue/tsconfig": "^0.8.1",
        "playwright": "1.63.0",
        "prettier": "^3.6.2",
        "typescript": "~5.9.3",
        "vite": "^7.2.2",
        "vue-tsc": "^3.1.3",
        "wrangler": "^4.141.0"
    }
}
